{
  "name": "robo",
  "version": "1.0.0",
  "type": "module",
  "description": "RoboDeal is a simple phone-friendly web app for playing poker with real cards while the phone sits in the middle of the table. It keeps track of players, chip amounts, turns, betting, pots, and hand results so players do not need to bring physical poker chips.",
  "main": "app.js",
  "scripts": {
    "test": "node --test",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "ai-speed": "node ai-speed-test.mjs",
    "voice-speed": "node ai-voice-speed-test.mjs",
    "e2e-speed": "node ai-e2e-latency.mjs",
    "human-speed": "node ai-human-latency.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samboodman/robodeal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/samboodman/robodeal/issues"
  },
  "homepage": "https://github.com/samboodman/robodeal#readme",
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
